# Copy to .env, then set unique database passwords before starting the services.

# Gemini
LLM_API_KEY=
# Chosen by the model comparison: see "Model choice" in the README
LLM_MODEL=gemini-3.8-flash

# PostgreSQL owner: used by the loader to create the schema and load the data
POSTGRES_DB=geo
POSTGRES_USER=geo_owner
POSTGRES_PASSWORD=

# Read-only role: the only role the agent uses to answer questions
DB_READONLY_USER=geo_reader
DB_READONLY_PASSWORD=
